<% if !@team.qube_connection %>
  <%= button_to "Connect to QuickBooks Desktop", qube_connections_path, class: "bg-green-500 hover:bg-green-600 text-white py-2 px-4 rounded", data: { turbo: false } %>
<% elsif @team.qube_connection.needs_onboarding? %>
  <p class="mb-2">Looks like you're QuickBooks connection hasn't been established yet. Open this link from the Windows computer where QuickBooks Desktop is installed:</p>
  <%= link_to "Connect to QuickBooks Desktop", onboarding_qube_connections_path, class: "bg-green-600 hover:bg-green-700 text-white py-2 px-4 rounded whitespace-nowrap", data: { turbo: false } %>
<% else %>
  <p class="p-2 mb-4 bg-orange-200 text-orange-800 rounded">
  <svg xmlns="http://www.w3.org/2000/svg" class="inline-block h-5 w-5 mr-2 align-middle" viewBox="0 0 20 20" fill="currentColor">
    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
  </svg>
  If you are disconnecting, please make sure to also remove the application from your QuickBooks Web Connector.
  </p>
  <%= button_to "Disconnect from QuickBooks Desktop", disconnect_qube_connections_path, method: :delete, class: "bg-red-600 hover:bg-red-700 text-white py-2 px-4 rounded" %>
<% end %>