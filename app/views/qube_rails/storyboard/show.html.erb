<%# The storyboard: each screen (@screens, QubeRails::Storyboard) in a card with its name, a note,
    the screen itself on a canvas, rendered by the engine's partials (or yours, where you've
    overridden them), and the pieces to override for it. Its styles are the opt-in stylesheet's,
    all under .qube-storyboard. %>
<% single = @screens.size == 1 %>
<% content_for :title, "QuickBooks screens" %>
<div class="qube-storyboard" id="qube-storyboard">
  <header class="qube-storyboard-header">
    <div>
      <h1>QuickBooks screens</h1>
      <p class="qube-storyboard-note">
        Every screen your users can meet, from sample data, in your layout. Override a piece by putting a
        file at its path in your app; add classes with config.ui_classes. Nothing here reaches QuBe Sync.
<% if single %>
        <%= link_to "All screens", qube_rails.storyboard_path %>
<% end %>
      </p>
    </div>
    <fieldset class="qube-storyboard-theme">
      <legend>Canvas</legend>
<% [["app", "As your page"], ["light", "Light"], ["dark", "Dark"]].each do |value, label| %>
      <label><input type="radio" name="qube-storyboard-canvas" value="<%= value %>" data-qube-canvas-theme="<%= value %>"<%= " checked" if value == "app" %>><%= label %></label>
<% end %>
    </fieldset>
  </header>
<% if flash[:qube_rails_storyboard] %>
  <p class="qube-storyboard-notice" role="status"><%= flash[:qube_rails_storyboard] %></p>
<% end %>
  <div class="qube-storyboard-body">
    <nav class="qube-storyboard-nav" aria-label="Screens">
<% QubeRails::Storyboard.screens.group_by(&:group).each do |group, screens| %>
      <div class="qube-storyboard-nav-group">
        <p class="qube-storyboard-nav-title"><%= group %></p>
        <ul>
<%   screens.each do |screen| %>
<%     href = single ? qube_rails.storyboard_screen_path(screen.key) : "#qube-storyboard-#{screen.key}" %>
          <li><%= link_to screen.title, href, "aria-current": (single && @screens.first.key == screen.key ? "page" : nil) %></li>
<%   end %>
        </ul>
      </div>
<% end %>
    </nav>
    <div class="qube-storyboard-screens">
<% @screens.each do |screen| %>
<%   answer = qube_rails.storyboard_answer_path(screen.key) %>
      <section class="qube-storyboard-panel" id="qube-storyboard-<%= screen.key %>" data-qube-storyboard="<%= screen.key %>"
               aria-labelledby="qube-storyboard-<%= screen.key %>-title">
        <header class="qube-storyboard-panel-head">
          <h2 id="qube-storyboard-<%= screen.key %>-title"><a href="#qube-storyboard-<%= screen.key %>"><%= screen.title %></a></h2>
          <span class="qube-storyboard-group"><%= screen.group %></span>
<%   unless single %>
          <%= link_to "Open on its own", qube_rails.storyboard_screen_path(screen.key), class: "qube-storyboard-open" %>
<%   end %>
        </header>
        <p class="qube-storyboard-note"><%= screen.note %></p>
        <div class="qube-storyboard-canvas" data-qube-storyboard-canvas>
<%   if screen.kind == :run_status %>
<%     view = QubeRails::Storyboard.run_status_view(screen, QubeRails::Storyboard::Urls.new(answer)) %>
<%     if view.visible? %>
          <%= render "qube_rails/run_status/status", run_status: view %>
<%     else %>
          <p class="qube-storyboard-empty">Nothing is shown before a record is sent.</p>
<%     end %>
<%   elsif screen.kind == :error %>
          <%= render "qube_rails/error", message: screen.sample[:message] %>
<%   else %>
          <%= render "qube_rails/question/question",
                     question: QubeRails::Storyboard.question_view(screen, answer, qube_rails.storyboard_search_path(screen.key)) %>
<%   end %>
        </div>
<%   if screen.partials.any? %>
        <details class="qube-storyboard-files">
          <summary>Override files (<%= screen.partials.size %>)</summary>
          <ul>
<%     screen.partials.each do |partial| %>
<%       path = QubeRails::Storyboard.override_path(partial) %>
            <li><code><%= path %></code><button type="button" class="qube-storyboard-copy" data-qube-copy="<%= path %>">Copy</button></li>
<%     end %>
          </ul>
        </details>
<%   end %>
      </section>
<% end %>
    </div>
  </div>
</div>
