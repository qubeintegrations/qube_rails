<%# A checkbox: ticked posts "true", sent as true; unticked, false. %>
<% control = capture do %>
<%= check_box_tag field.input_name, "true", field.value.to_s == "true", id: field.dom_id, disabled: field.disabled,
                  class: qube_classes(:checkbox, "qube-checkbox", field.cell? ? "qube-rows-input" : nil),
                  "aria-label": (field.labelled? ? nil : field.label), data: field.data, **field.aria_invalid %>
<% end %>
<%= render "qube_rails/question/field", field: field, control: control %>
