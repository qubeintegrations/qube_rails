<%# A fixed list (field.options, each value and label), with "Choose…" (question.choose) first;
    field.value (a column's default, or what a refused answer had) starts selected. %>
<% control = capture do %>
<%= select_tag field.input_name, options_for_select(field.options.map { |o| [o.label, o.value] }, field.value),
               id: field.dom_id, include_blank: QubeRails.t("question.choose"), required: field.required,
               disabled: field.disabled, class: qube_classes(:select, "qube-select", field.cell? ? "qube-rows-input" : nil),
               "aria-label": (field.labelled? ? nil : field.label), data: field.data, **field.aria_invalid %>
<% end %>
<%= render "qube_rails/question/field", field: field, control: control %>
