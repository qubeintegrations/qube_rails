<%# The question's picks (question.picks): option rows, one form each. When they're the records
    QuBe Sync offers (question.matches?), under a "Possible matches" heading. %>
<% if question.matches? %>
<div class="qube-picks" role="group" aria-labelledby="qube-<%= question.token %>-matches">
  <p class="<%= qube_classes(:label, "qube-rows-label") %>" id="qube-<%= question.token %>-matches"><%= question.ui_text(:possible_matches) %></p>
<% end %>
<div class="<%= qube_classes(:picks, "qube-picks") %>" role="list">
<% question.picks.each do |choice| %>
  <%= render "qube_rails/question/pick", question: question, choice: choice %>
<% end %>
</div>
<% if question.matches? %>
</div>
<% end %>
