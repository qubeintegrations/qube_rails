<%# The question's picks (question.picks): option rows, one form each. When they're the records
    QuBe Sync offers (question.matches?), the search (question.searches) follows behind
    "Search QuickBooks…". The question's message says what they are, so they have no heading. %>
<% if question.matches? %>
<div class="qube-picks" role="group">
<% end %>
<div class="<%= qube_classes(:picks, "qube-picks") %>" role="list">
<% question.picks.each do |choice| %>
  <%= render "qube_rails/question/pick", question: question, choice: choice %>
<% end %>
</div>
<% if question.matches? %>
<% question.searches.each do |choice| %>
  <%= render "qube_rails/question/search_disclosure", question: question, choice: choice %>
<% end %>
</div>
<% end %>
