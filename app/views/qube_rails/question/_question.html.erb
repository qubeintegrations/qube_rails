<%# A question (a QubeRails::QuestionView): a refusal, its message, what it's about, then its
    choices by kind: the picks (option rows), each form choice ("or" between), and the exits in a
    footer. With one form and no picks, the exits share that form's button row instead (question.
    joined_form). A question with neither picks nor forms shows its choices in one row.
    Offered records with a search (question.chain?) show a branch at a time: each part carries
    data-qube-branch-part, and the one not on show is hidden; the script moves between them.
    data-qube-button-*-class are the script's, for swapping a button's weight. %>
<section class="<%= qube_classes(:question, "qube-question") %>" data-qube-question="<%= question.token %>"
         data-qube-button-class="<%= qube_classes(:button) %>" data-qube-button-secondary-class="<%= qube_classes(:button_secondary) %>">
  <%= render "qube_rails/error", message: question.error, id: question.error_id %>
  <%= render "qube_rails/question/message", question: question %>
<% if question.details.any? %>
  <%= render "qube_rails/question/details", question: question %>
<% end %>
  <div class="qube-choices">
<% if question.chain? %>
    <button type="button" class="<%= qube_classes(:button_ghost, "qube-choice-button", "qube-branch-back") %>" data-qube-button="ghost" data-qube-branch="offered" data-qube-branch-part="search" hidden><%= question.ui_text(:back_to_offered, count: question.offered_count) %></button>
<% end %>
<% if question.picks.any? %>
    <%= render "qube_rails/question/picks", question: question %>
<% end %>
<% joined = question.joined_form %>
<% question.forms.each_with_index do |choice, n| %>
<%   if question.divided?(choice, n) %>
<%     part = question.branch_part(choice) %>
    <div class="<%= qube_classes(:choice_divider, "qube-choice-divider") %>" role="separator"<% if part %> data-qube-branch-part="<%= part %>"<% end %><%= " hidden" unless question.shown_part?(part) %>><span><%= QubeRails.t("question.or") %></span></div>
<%   end %>
    <%= render "qube_rails/question/choice", question: question, choice: choice,
                                             exits: (choice.equal?(joined) ? question.joined_exits : []) %>
<% end %>
<% if joined && !question.chain? %>
<%   question.exits.each do |choice| %>
    <%= render "qube_rails/question/choice", question: question, choice: choice, detached: true %>
<%   end %>
<% elsif question.exits.any? || question.chain? %>
    <%= render "qube_rails/question/footer", question: question %>
<% end %>
  </div>
</section>
