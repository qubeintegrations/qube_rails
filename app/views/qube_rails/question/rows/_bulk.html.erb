<%# A column's "Set selected" control (cell.field, posted with nothing) and its Apply button, or
    an empty cell for a column with none. %>
<td data-qube-bulk="<%= cell.column %>">
<% if cell.field %>
  <%= render cell.field.partial, field: cell.field %>
  <button type="button" class="<%= qube_classes(:button_secondary, "qube-bulk-apply") %>" data-qube-bulk-apply><%= QubeRails.t("question.apply") %></button>
<% end %>
</td>
