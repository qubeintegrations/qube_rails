<%# An exit's button in a form choice's row: it submits the exit's own form (form=), rendered
    detached after the question's forms. %>
<button type="submit" form="<%= choice.form_id %>" class="<%= qube_classes(choice.button_piece, "qube-choice-button") %>" data-qube-button="<%= choice.style %>" data-qube-exit="<%= choice.id %>"<% if choice.role %> data-qube-choice-role="<%= choice.role %>"<% end %>>
  <%= choice.label %>
<% if choice.detail %>
  <span class="<%= qube_classes(:choice_detail, "qube-choice-detail") %>"><%= choice.detail %></span>
<% end %>
</button>
