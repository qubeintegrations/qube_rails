<%# A record's status (run_status, a QubeRails::RunStatusView): the error, then the summary, the
    failure's detail, why it waits on a stalled connection, and the buttons, or only the error
    before it's sent. %>
<%= render "qube_rails/error", message: run_status.error %>
<% if run_status.visible? %>
<div class="<%= qube_classes(:status, run_status.css_class) %>" data-qube-sync-status="<%= run_status.status %>"<% if run_status.stall %> data-qube-stall="<%= run_status.stall %>"<% end %>>
  <%= render "qube_rails/run_status/summary", run_status: run_status %>
<%   if run_status.detail %>
  <%= render "qube_rails/run_status/detail", run_status: run_status %>
<%   end %>
<%   if run_status.stall %>
  <%= render "qube_rails/run_status/stall", run_status: run_status %>
<%   end %>
<%   if run_status.redeliver_url %>
  <%= render "qube_rails/run_status/redeliver", run_status: run_status %>
<%   end %>
<%   if run_status.retry_url %>
  <%= render "qube_rails/run_status/retry", run_status: run_status %>
<%   end %>
</div>
<% end %>
